# Copie ce fichier en ".env" puis remplis les valeurs
DISCORD_TOKEN=ton_token_ici
CLIENT_ID=id_de_l_application
GUILD_ID=id_de_ton_serveur_discord
# Pont Minecraft : même valeur que discord-bridge.secret dans plugins/mcbloc-proxy/config.yml
BRIDGE_SECRET=
# Dossier des données (Railway : volume monté sur /data)
DATA_DIR=/data
# Facultatif : source des infos publiques (liens, jeux, règles, votes) publiée par le site
# NETWORK_URL=https://mcbloc.fr/network.json
# Facultatif : origines autorisées à lire /public/votes et /public/leaderboards
# PUBLIC_ORIGINS=https://mcbloc.fr,https://www.mcbloc.fr
